# Compiled output — rebuilt inside the container
target/

# Git metadata
.git/
.gitignore
.gitattributes

# IDE and editor files
.idea/
*.iml
.vscode/
*.code-workspace

# OS artifacts
.DS_Store
Thumbs.db

# Logs
*.log

# Environment files — never bake secrets into the image
.env
.env.*
*.env

# Documentation
*.md

# Docker files — not needed in build context
Dockerfile
compose*.yml
compose*.yaml
docker-compose*.yml
docker-compose*.yaml

# Eclipse / Spring Tool Suite
**/.classpath
**/.project
**/.settings/
**/.factorypath
