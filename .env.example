SERVER_PORT=8080
TRAEFIK_DASHBOARD_PORT=8081
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
GATEWAY_HOST=api.orionticket.example
LETSENCRYPT_EMAIL=ops@orionticket.example
IMAGE_TAG=latest
ORION_ENV_FILE=.env

# Identity runs in this compose and is used internally by the Gateway.
JWT_ISSUER=orionticket-identity
IDENTITY_SERVICE_URL=http://identity-service:8081
IDENTITY_JWKS_URI=http://identity-service:8081/.well-known/jwks.json
IDENTITY_SERVICE_PORT=8081
IDENTITY_SPRING_PROFILES_ACTIVE=prod

# Bind Identity to localhost by default. In the infra VPS, use its Tailscale IP
# so other services can reach JWKS without exposing Identity publicly.
IDENTITY_BIND_ADDRESS=127.0.0.1

# Identity database and RabbitMQ connectivity.
DB_HOST=100.64.0.20
DB_PORT=5000
GLOBAL_DB_NAME=orionticketdb
GLOBAL_DB_USER=app_user
GLOBAL_DB_PASSWORD=change-me
DB_SCHEMA=identity
RABBITMQ_HOST=100.64.0.30
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Identity JWT signing. Generate real RSA PEM values for every environment.
JWT_KEY_ID=orionticket-key-1
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----
JWT_EXPIRATION=86400

# Tailscale upstreams. Replace these with MagicDNS names or real 100.x.y.z node IPs.
EVENT_MANAGEMENT_SERVICE_URL=http://100.64.0.12:8082
SEATING_INVENTORY_SERVICE_URL=http://100.64.0.13:8083
ORDERS_SERVICE_URL=http://100.64.0.14:8084
PAYMENTS_SERVICE_URL=http://100.64.0.15:8085
TICKET_ISSUANCE_SERVICE_URL=http://100.64.0.16:8086
NOTIFICATIONS_SERVICE_URL=http://100.64.0.17:8088
